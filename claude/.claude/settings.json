{
  "theme": "dark",
  "tui": "fullscreen",
  "permissions": {
    "allow": [
      "Read",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(.env)",
      "Read(./secrets/**)",
      "Read(/**/*.pem)",
      "Read(/**/.ssh/personal)",
      "Read(/**/.ssh/work)",
      "Read(/**/.aws/credentials)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(find * -delete*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(shred *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch*)",
      "Bash(rsync *--delete*)",
      "Bash(npm publish*)"
    ]
  }
}
